pipeline {
  agent any

  environment {
    IMAGE_REGISTRY = 'mechayan97'
    MICROSERVICE_IMAGE_REPO = "${IMAGE_REGISTRY}/microservice"
    MONOLITH_IMAGE_REPO = "${IMAGE_REGISTRY}/monolith"
    FRONTEND_IMAGE_REPO = "${IMAGE_REGISTRY}/frontend-angular"
    APP_NAMESPACE = 'enterprise-app'
    EMAIL_TO = 'chayansamanta8@gmail.com'
  }

  parameters {
    string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Image tag to deploy')
    string(name: 'DB_HOST', defaultValue: 'postgres.enterprise-app.svc.cluster.local', description: 'Database host')
    string(name: 'DB_PORT', defaultValue: '5432', description: 'Database port')
    string(name: 'DB_NAME', defaultValue: 'app_db', description: 'Database name')
    string(name: 'DB_USER', defaultValue: 'app_user', description: 'Database user')
    password(name: 'DB_PASSWORD', defaultValue: 'app_password', description: 'Database password')
    booleanParam(name: 'ROLLBACK_ONLY', defaultValue: false, description: 'Rollback Kubernetes deployments only')
  }

  stages {
    stage('Deploy PROD Images') {
      when {
        expression { return !params.ROLLBACK_ONLY }
      }
      steps {
        sh '''
          NEW_MICROSERVICE_IMAGE="${MICROSERVICE_IMAGE_REPO}:${IMAGE_TAG}"
          NEW_FRONTEND_IMAGE="${FRONTEND_IMAGE_REPO}:${IMAGE_TAG}"
          NEW_MONOLITH_IMAGE="${MONOLITH_IMAGE_REPO}:${IMAGE_TAG}"

          # Substitute image placeholders
          sed "s|__MICROSERVICE_IMAGE__|${NEW_MICROSERVICE_IMAGE}|g" k8s/microservice/deployment.yaml > k8s/microservice/deployment.rendered.yaml
          sed "s|__FRONTEND_IMAGE__|${NEW_FRONTEND_IMAGE}|g" k8s/frontend/deployment.yaml > k8s/frontend/deployment.rendered.yaml
          sed "s|__MONOLITH_IMAGE__|${NEW_MONOLITH_IMAGE}|g" k8s/monolith/deployment.yaml > k8s/monolith/deployment.rendered.yaml
          
          # Substitute database credentials in secrets
          sed -e "s|__DB_HOST__|${DB_HOST}|g" -e "s|__DB_PORT__|${DB_PORT}|g" -e "s|__DB_NAME__|${DB_NAME}|g" -e "s|__DB_USER__|${DB_USER}|g" -e "s|__DB_PASSWORD__|${DB_PASSWORD}|g" k8s/secrets.yaml > k8s/secrets.rendered.yaml

          kubectl create namespace ${APP_NAMESPACE} --dry-run=client -o yaml | kubectl apply -f -

          # Apply namespace and configs
          kubectl apply -f k8s/namespace.yaml
          kubectl apply -f k8s/configmap.yaml
          kubectl apply -f k8s/secrets.rendered.yaml
          
          # Apply database
          kubectl apply -f k8s/postgres/pvc.yaml
          kubectl apply -f k8s/postgres/deployment.yaml
          
          # Apply frontend
          kubectl apply -f k8s/frontend/service.yaml
          kubectl apply -f k8s/frontend/deployment.rendered.yaml
          
          # Apply monolith
          kubectl apply -f k8s/monolith/service.yaml
          kubectl apply -f k8s/monolith/deployment.rendered.yaml
          
          # Apply microservice
          kubectl apply -f k8s/microservice/service.yaml
          kubectl apply -f k8s/microservice/deployment.rendered.yaml
          
          # Apply ingress
          kubectl apply -f k8s/ingress.yaml

          kubectl rollout status deployment/microservice -n ${APP_NAMESPACE}
          kubectl rollout status deployment/frontend -n ${APP_NAMESPACE}
          kubectl rollout status deployment/monolith -n ${APP_NAMESPACE}
        '''
      }
    }

    stage('Validate PROD') {
      when {
        expression { return !params.ROLLBACK_ONLY }
      }
      steps {
        sh 'mkdir -p reports && kubectl get pods -n ${APP_NAMESPACE} | tee reports/prod-pods.txt'
        sh '''
          kubectl port-forward -n ${APP_NAMESPACE} svc/monolith 18080:80 > prod-monolith-port-forward.log 2>&1 &
          PF_PID=$!
          trap "kill ${PF_PID} >/dev/null 2>&1 || true" EXIT
          sleep 5
          curl -fsS http://127.0.0.1:18080/monolith/health >/dev/null
          curl -fsS http://127.0.0.1:18080/monolith/api/microservice-status | tee reports/prod-monolith-microservice-bridge.json
        '''
      }
    }

    stage('Rollback PROD') {
      when {
        expression { return params.ROLLBACK_ONLY }
      }
      steps {
        sh '''
          kubectl rollout undo deployment/microservice -n ${APP_NAMESPACE} || true
          kubectl rollout undo deployment/frontend -n ${APP_NAMESPACE} || true
          kubectl rollout undo deployment/monolith -n ${APP_NAMESPACE} || true
        '''
      }
    }
  }

  post {
    always {
      sh 'rm -f k8s/**/*.rendered.yaml || true'
      script {
        sh """
          mkdir -p reports
          cat > reports/prod-summary.txt <<EOF
Build: ${env.BUILD_NUMBER}
Result: ${currentBuild.currentResult}
Image Tag: ${params.IMAGE_TAG}
Namespace: ${env.APP_NAMESPACE}
DB Host: ${params.DB_HOST}
URL: ${env.BUILD_URL}
EOF
        """
      }
      archiveArtifacts artifacts: 'reports/**', allowEmptyArchive: true
      emailext(
        to: "${EMAIL_TO}",
        subject: "[PROD Deploy] ${currentBuild.currentResult} - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
        mimeType: 'text/html',
        body: """
          <p><b>Pipeline:</b> ${env.JOB_NAME}</p>
          <p><b>Status:</b> ${currentBuild.currentResult}</p>
          <p><b>Image Tag:</b> ${params.IMAGE_TAG}</p>
          <p><b>Namespace:</b> ${env.PROD_NAMESPACE}</p>
          <p><a href='${env.BUILD_URL}'>Open Build</a></p>
        """,
        attachmentsPattern: 'reports/**',
        attachLog: true
      )
    }
  }
}
