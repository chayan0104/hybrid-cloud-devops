  //     steps {
  //       sh '''
  //         JFROG_USER=$(VAULT_ADDR=${VAULT_ADDR} VAULT_TOKEN=${VAULT_TOKEN} vault kv get -field=username secret/shared/jfrog)
  //         JFROG_PASSWORD=$(VAULT_ADDR=${VAULT_ADDR} VAULT_TOKEN=${VAULT_TOKEN} vault kv get -field=password secret/shared/jfrog)

  //         docker login ${JFROG_SERVER#https://} -u ${JFROG_USER} -p ${JFROG_PASSWORD}

  //         docker tag ${MICROSERVICE_IMAGE_REPO}:${IMAGE_TAG} ${JFROG_SERVER#https://}/${JFROG_DOCKER_REPO}/microservice:${IMAGE_TAG}
  //         docker tag ${MAIN_APP_IMAGE_REPO}:${IMAGE_TAG} ${JFROG_SERVER#https://}/${JFROG_DOCKER_REPO}/monolith:${IMAGE_TAG}
  //         docker tag ${FRONTEND_IMAGE_REPO}:${IMAGE_TAG} ${JFROG_SERVER#https://}/${JFROG_DOCKER_REPO}/frontend-angular:${IMAGE_TAG}

  //         docker push ${JFROG_SERVER#https://}/${JFROG_DOCKER_REPO}/microservice:${IMAGE_TAG}
  //         docker push ${JFROG_SERVER#https://}/${JFROG_DOCKER_REPO}/monolith:${IMAGE_TAG}
  //         docker push ${JFROG_SERVER#https://}/${JFROG_DOCKER_REPO}/frontend-angular:${IMAGE_TAG}

    //         curl -u ${JFROG_USER}:${JFROG_PASSWORD} -T applications/monolith/target/monolith.war \
    //           ${JFROG_SERVER}/artifactory/${JFROG_GENERIC_REPO}/monolith/monolith-${IMAGE_TAG}.war
    //       '''
    //     }
    //   }
       stage('Publish Images') {
         when {
           allOf {
             expression { return params.PUSH_ARTIFACTS }
             expression { return env.CHANGE_ID == null }
           }
         }
   
         steps {
           withCredentials([
         usernamePassword(
           credentialsId: 'dockerhub-creds',
           usernameVariable: 'DOCKER_USER',
           passwordVariable: 'DOCKER_PASS'
         )
       ]) {
             sh '''
           echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
   
           docker push ${MICROSERVICE_IMAGE_REPO}:${IMAGE_TAG}
           docker push ${MAIN_APP_IMAGE_REPO}:${IMAGE_TAG}
           docker push ${FRONTEND_IMAGE_REPO}:${IMAGE_TAG}
         '''
       }
         }
       }
  }
  post {
    always {
      script {
        sh """
          mkdir -p reports
          cat > reports/ci-summary.txt <<EOF
Build: ${env.BUILD_NUMBER}
Result: ${currentBuild.currentResult}
Job: ${env.JOB_NAME}
URL: ${env.BUILD_URL}
EOF
        """
      }
      archiveArtifacts artifacts: 'applications/monolith/target/*.war', fingerprint: true
      archiveArtifacts artifacts: 'applications/frontend-angular/dist/**', allowEmptyArchive: true
      archiveArtifacts artifacts: 'reports/**', allowEmptyArchive: true
      junit testResults: 'applications/**/target/surefire-reports/*.xml', allowEmptyResults: true
      emailext(
        to: "${EMAIL_TO}",
        subject: "[CI] ${currentBuild.currentResult} - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
        mimeType: 'text/html',
        body: """
          <p><b>Pipeline:</b> ${env.JOB_NAME}</p>
          <p><b>Build:</b> #${env.BUILD_NUMBER}</p>
          <p><b>Status:</b> ${currentBuild.currentResult}</p>
          <p><b>Reports:</b> Trivy and build summaries attached.</p>
          <p><a href='${env.BUILD_URL}'>Open Build</a></p>
        """,
        attachmentsPattern: 'reports/**, applications/monolith/target/*.war, applications/frontend-angular/dist/**',
        attachLog: true
      )
    }
  }
}
