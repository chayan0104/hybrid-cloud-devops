    //         ).trim()
    //         env.JFROG_DOCKER_REPO = sh(
    //           script: 'VAULT_ADDR=${VAULT_ADDR} VAULT_TOKEN=${VAULT_TOKEN} vault kv get -field=docker_repo secret/shared/jfrog',
    //           returnStdout: true
    //         ).trim()
    //         env.JFROG_GENERIC_REPO = sh(
    //           script: 'VAULT_ADDR=${VAULT_ADDR} VAULT_TOKEN=${VAULT_TOKEN} vault kv get -field=generic_repo secret/shared/jfrog',
    //           returnStdout: true
    //         ).trim()
    //       }
    //     }
    //   }
    // }

    stage('Build Frontend Angular Container') {
      steps {
        dir('applications/frontend-angular') {
          sh 'npm install'
          sh 'npm run build'
          sh 'docker build -t ${FRONTEND_IMAGE_REPO}:${IMAGE_TAG} .'
        }
      }
    }

    stage('Build Main App') {
      steps {
        dir('applications/monolith') {
          sh 'mvn -B clean package'
          sh 'docker build -t ${MAIN_APP_IMAGE_REPO}:${IMAGE_TAG} .'
        }
      }
    }

    stage('Build Microservice') {
      steps {
        dir('applications/microservice') {
          sh 'mvn -B clean test package'
          sh 'docker build -t ${MICROSERVICE_IMAGE_REPO}:${IMAGE_TAG} .'
        }
      }
    }

    stage('SonarQube Analysis') {
      when {
        expression { return params.RUN_CODE_SCANS }
      }
      steps {
        withCredentials([string(credentialsId: 'sonar-token', variable: 'sonar-token')]) {
          sh '''
            mkdir -p reports

            cd applications/monolith
            mvn -B sonar:sonar \
              -Dsonar.projectKey=monolith \
              -Dsonar.host.url=${SONAR_HOST_URL} \
              -Dsonar.login=${SONAR_TOKEN} | tee ../../reports/sonar-monolith.txt

            cd ../microservice
            mvn -B sonar:sonar \
              -Dsonar.projectKey=microservice \
              -Dsonar.host.url=${SONAR_HOST_URL} \
              -Dsonar.login=${SONAR_TOKEN} | tee ../../reports/sonar-microservice.txt
          '''
        }
      }
    }

    stage('Dependency Audit') {
      when {
        expression { return params.RUN_CODE_SCANS }
      }
      steps {
        sh '''
          mkdir -p reports

          cd applications/frontend-angular
          npm audit --audit-level=high | tee ../../reports/npm-audit-frontend.txt

          cd ../monolith
          mvn -B org.owasp:dependency-check-maven:check -DfailBuildOnCVSS=7 | tee ../../reports/dependency-check-monolith.txt

          cd ../microservice
          mvn -B org.owasp:dependency-check-maven:check -DfailBuildOnCVSS=7 | tee ../../reports/dependency-check-microservice.txt
        '''
      }
    }

    stage('IaC Security Scan (tfsec/checkov)') {
      when {
        expression { return params.RUN_CODE_SCANS }
      }
      steps {
        sh '''
          mkdir -p reports

          docker run --rm -v "$PWD":/workspace aquasec/tfsec:v1.28.5 \
            /workspace/infra/terraform --format text | tee reports/tfsec.txt

          docker run --rm -v "$PWD":/workspace bridgecrew/checkov:3.2.360 \
            -d /workspace/infra/terraform --quiet | tee reports/checkov.txt
        '''
      }
    }

    stage('Secrets Scan (gitleaks)') {
      when {
        expression { return params.RUN_CODE_SCANS }
      }
      steps {
        sh '''
          mkdir -p reports

          docker run --rm -v "$PWD":/repo zricethezav/gitleaks:v8.21.2 \
            detect --source=/repo --report-format sarif --report-path=/repo/reports/gitleaks.sarif
        '''
      }
    }

    stage('Docker-based Security Scans') {
      when {
        expression { return params.RUN_DOCKER_SCANS }
      }
      steps {
        sh '''
          mkdir -p reports

          docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \
            aquasec/trivy:0.56.2 image --severity HIGH,CRITICAL --exit-code 1 ${MICROSERVICE_IMAGE_REPO}:${IMAGE_TAG} | tee reports/trivy-microservice.txt

          docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \
            aquasec/trivy:0.56.2 image --severity HIGH,CRITICAL --exit-code 1 ${MAIN_APP_IMAGE_REPO}:${IMAGE_TAG} | tee reports/trivy-monolith.txt

          docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \
            aquasec/trivy:0.56.2 image --severity HIGH,CRITICAL --exit-code 1 ${FRONTEND_IMAGE_REPO}:${IMAGE_TAG} | tee reports/trivy-frontend-angular.txt

          docker run --rm -v "$PWD":/workspace aquasec/trivy:0.56.2 fs --severity HIGH,CRITICAL --exit-code 1 /workspace | tee reports/trivy-filesystem.txt
        '''
      }
    }

  //   stage('Publish to JFrog') {
  //     when {
  //       allOf {
  //         expression { return params.PUSH_ARTIFACTS }
  //         expression { return env.CHANGE_ID == null }
  //       }
