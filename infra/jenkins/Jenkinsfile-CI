pipeline {
  agent any

  environment {
    IMAGE_REGISTRY = 'mechayan97'
    MICROSERVICE_IMAGE_REPO = "${IMAGE_REGISTRY}/microservice"
    MAIN_APP_IMAGE_REPO = "${IMAGE_REGISTRY}/monolith"
    FRONTEND_IMAGE_REPO = "${IMAGE_REGISTRY}/frontend-angular"
    IMAGE_TAG = "${env.BUILD_NUMBER}"
    JFROG_SERVER = ''
    JFROG_DOCKER_REPO = ''
    JFROG_GENERIC_REPO = ''
    VAULT_ADDR = 'https://vault.company.com:8200'
    SONAR_HOST_URL = "http://localhost:9000"
    EMAIL_TO = 'chayansamanta8@gmail.com'
  }

  parameters {
    booleanParam(name: 'RUN_DOCKER_SCANS', defaultValue: true, description: 'Run Trivy image and filesystem scans')
    booleanParam(name: 'RUN_CODE_SCANS', defaultValue: true, description: 'Run SonarQube, dependency audits, IaC scans, and gitleaks')
    booleanParam(name: 'PUSH_ARTIFACTS', defaultValue: true, description: 'Push images and WAR to ${Env.IMAGE_REGISTRY} and JFrog (if configured)')
  }

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  stages {
    stage('Validate Toolchain') {
      steps {
        sh 'java -version'
        sh 'mvn -version'
        sh 'docker version'
        sh 'node --version'
        sh 'npm --version'
      }
    }

    // stage('Load Shared Secrets from Vault') {
