pipeline {
  agent any

  environment {
    IMAGE_REGISTRY = 'mechayan97'
    MICROSERVICE_IMAGE_REPO = "${IMAGE_REGISTRY}/microservice"
    MAIN_APP_IMAGE_REPO = "${IMAGE_REGISTRY}/monolith"
    FRONTEND_IMAGE_REPO = "${IMAGE_REGISTRY}/frontend-angular"
    //IMAGE_TAG = "${env.BUILD_NUMBER}"
    IMAGE_TAG = "latest"
    JFROG_SERVER = ''
    JFROG_DOCKER_REPO = ''
    JFROG_GENERIC_REPO = ''
    VAULT_ADDR = 'https://vault.company.com:8200'
    SONAR_HOST_URL = 'http://localhost:9000'
    EMAIL_TO = 'chayansamanta8@gmail.com'
  }

  parameters {
    booleanParam(name: 'START_BUILD', defaultValue: true, description: 'Build frontend, main app, and microservice')
    booleanParam(name: 'RUN_CODE_SCANS', defaultValue: true, description: 'Run SonarQube, dependency audits, IaC scans, and gitleaks')
    booleanParam(name: 'RUN_DOCKER_SCANS', defaultValue: true, description: 'Run Trivy image and filesystem scans')
    booleanParam(name: 'PUSH_ARTIFACTS', defaultValue: true, description: 'Push images and WAR to Docker Hub')
  }

  options {
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 2, unit: 'HOURS')
    buildDiscarder(logRotator(numToKeepStr: '10'))
  }

  stages {
    stage('Validate Toolchain') {
      steps {
        sh '''
          #!/bin/sh
          set -e
          java -version
          mvn -version
          docker version
          node --version
          npm --version
        '''
      }
    }

    stage('Build Applications') {
      when {
        expression { return params.START_BUILD }
      }
      parallel {
        stage('Build Angular') {
          steps {
            dir('applications/frontend-angular') {
              sh '''
                #!/bin/sh
                set -eu
                npm ci
                npm run build
                docker build -t ${FRONTEND_IMAGE_REPO}:${IMAGE_TAG} .
              '''
            }
          }
        }

        stage('Build Monolith') {
          steps {
            dir('applications/monolith') {
              sh '''
                #!/bin/sh
                set -eu
                mvn -B clean package -DskipTests
                docker build -t ${MAIN_APP_IMAGE_REPO}:${IMAGE_TAG} .
              '''
            }
          }
        }

        stage('Build Microservice') {
          steps {
            dir('applications/microservice') {
              sh '''
                #!/bin/sh
                set -eu
                mvn -B clean test package
                docker build -t ${MICROSERVICE_IMAGE_REPO}:${IMAGE_TAG} .
              '''
            }
          }
        }
      }
    }

    stage('Security Scans') {
      parallel {
        stage('Code Security Scans') {
          when {
            expression { return params.RUN_CODE_SCANS }
          }
          stages {
            stage('SonarQube Analysis') {
              steps {
                withCredentials([string(credentialsId: 'sonarqube-token', variable: 'SONAR_TOKEN')]) {
                  sh '''
                    #!/bin/sh
                    set -eu
                    mkdir -p reports

                    cd applications/monolith
                    mvn -B org.sonarsource.scanner.maven:sonar-maven-plugin:4.0.0.4121:sonar \
                      -Dsonar.projectKey=monolith \
                      -Dsonar.host.url=${SONAR_HOST_URL} \
                      -Dsonar.token=${SONAR_TOKEN} \
                      -Dsonar.sources=src | tee ../../reports/sonar-monolith.txt

                    cd ../microservice
                    mvn -B org.sonarsource.scanner.maven:sonar-maven-plugin:4.0.0.4121:sonar \
                      -Dsonar.projectKey=microservice \
                      -Dsonar.host.url=${SONAR_HOST_URL} \
                      -Dsonar.token=${SONAR_TOKEN} \
                      -Dsonar.sources=src/main/java \
                      -Dsonar.tests=src/test/java  | tee ../../reports/sonar-microservice.txt
                  '''
                }
              }
            }

            stage('Dependency Audit') {
              options {
                timeout(time: 25, unit: 'MINUTES')
              }
              steps {
                sh '''
                  #!/bin/sh
                  set -eu
                  mkdir -p reports

                  cd applications/frontend-angular
                  npm audit --omit=dev --audit-level=moderate 2>&1 | tee ../../reports/npm-audit-frontend.txt || true

                  cd ../monolith
                  mvn -B org.owasp:dependency-check-maven:check \
                    -DdataDirectory=/var/jenkins_home/dependency-check-data \
                    -DfailBuildOnCVSS=7 | tee ../../reports/dependency-check-monolith.txt

                  cd ../microservice
                  mvn -B org.owasp:dependency-check-maven:check \
                    -DdataDirectory=/var/jenkins_home/dependency-check-data \
                    -DfailBuildOnCVSS=7 | tee ../../reports/dependency-check-microservice.txt
                '''
              }
            }

            stage('IaC/Infra Code Scan') {
              steps {
                sh '''
                  #!/bin/sh
                  set -eu
                  mkdir -p reports

                  docker run --rm -v "$PWD":/workspace aquasec/tfsec:v1.28.5 \
                    /workspace/infra/terraform --format text | tee reports/tfsec.txt

                  docker run --rm -v "$PWD":/workspace bridgecrew/checkov:3.2.360 \
                    -d /workspace/infra/terraform --quiet | tee reports/checkov_tf.txt || true

                  docker run --rm -v "$PWD":/workspace bridgecrew/checkov:3.2.360 \
                    -d /workspace/infra/kubernetes --quiet | tee reports/checkov_k8s.txt || true

                  docker run --rm -v "$PWD":/workspace bridgecrew/checkov:3.2.360 \
                    -d /workspace/infra/helm --quiet | tee reports/checkov_helm.txt || true

                  docker run --rm -v "$PWD":/workspace bridgecrew/checkov:3.2.360 \
                    -d /workspace/infra/jenkins --quiet | tee reports/checkov_jenkins.txt || true

                '''
              }
            }

            stage('Secrets Scan') {
              steps {
                sh '''
                  #!/bin/sh
                  set -eu
                  mkdir -p reports

                  docker run --rm -v "$PWD":/repo zricethezav/gitleaks:v8.21.2 \
                    detect --source=/repo --exit-code 0 -> reports/gitleaks.txt 2>&1
                '''
              }
            }
          }
        }

        stage('Docker Image Scans') {
          when {
            expression { return params.RUN_DOCKER_SCANS && params.START_BUILD }
          }
          stages {
            stage('Trivy Image Scans') {
              steps {
                sh '''
                  #!/bin/sh
                  set -eu
                  mkdir -p reports

                  docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \
                    aquasec/trivy:0.56.2 image --severity HIGH,CRITICAL --exit-code 0 \
                    ${MICROSERVICE_IMAGE_REPO}:${IMAGE_TAG} | tee reports/trivy-microservice.txt

                  docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \
                    aquasec/trivy:0.56.2 image --severity HIGH,CRITICAL --exit-code 0 \
                    ${MAIN_APP_IMAGE_REPO}:${IMAGE_TAG} | tee reports/trivy-monolith.txt

                  docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \
                    aquasec/trivy:0.56.2 image --severity HIGH,CRITICAL --exit-code 0 \
                    ${FRONTEND_IMAGE_REPO}:${IMAGE_TAG} | tee reports/trivy-frontend-angular.txt
                '''
              }
            }

            stage('Trivy Filesystem Scan') {
              steps {
                sh '''
                  #!/bin/sh
                  set -eu
                  mkdir -p reports

                  docker run --rm -v "$PWD":/workspace aquasec/trivy:0.56.2 \
                    fs --severity HIGH,CRITICAL --exit-code 0 /workspace | tee reports/trivy-filesystem.txt
                '''
              }
            }
          }
        }
      }
    }

    stage('Publish Images') {
      when {
        allOf {
          expression { return params.PUSH_ARTIFACTS }
          expression { return env.CHANGE_ID == null }
          expression { return params.START_BUILD }
        }
      }
      steps {
        withCredentials([
          usernamePassword(
            credentialsId: 'dockerhub-creds',
            usernameVariable: 'DOCKER_USER',
            passwordVariable: 'DOCKER_PASS'
          )
        ]) {
          sh '''
            #!/bin/sh
            set -eu
            echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
            docker push ${MICROSERVICE_IMAGE_REPO}:${IMAGE_TAG}
            docker rmi ${MICROSERVICE_IMAGE_REPO}:${IMAGE_TAG} || true

            docker push ${MAIN_APP_IMAGE_REPO}:${IMAGE_TAG}
            docker rmi ${MAIN_APP_IMAGE_REPO}:${IMAGE_TAG} || true

            docker push ${FRONTEND_IMAGE_REPO}:${IMAGE_TAG}
            docker rmi ${FRONTEND_IMAGE_REPO}:${IMAGE_TAG} || true

            docker system prune -af
            docker logout
          '''
        }
      }
    }
  }

  post {
    always {
      script {
        writeFile file: 'reports/ci-summary.txt', text: """=====================================
  BUILD SUMMARY
=====================================
Build Number: ${env.BUILD_NUMBER}
Job Name: ${env.JOB_NAME}
Build Status: ${currentBuild.currentResult ?: 'SUCCESS'}
Build URL: ${env.BUILD_URL}
Timestamp: ${new Date().toString()}
Branch: ${env.BRANCH_NAME ?: 'HEAD'}
Commit: ${env.GIT_COMMIT ?: 'N/A'}
=====================================
"""
      }

      archiveArtifacts artifacts: 'applications/monolith/target/*.war', fingerprint: true, allowEmptyArchive: true
      archiveArtifacts artifacts: 'applications/frontend-angular/dist/**', allowEmptyArchive: true
      archiveArtifacts artifacts: 'reports/**', allowEmptyArchive: true
      junit testResults: 'applications/**/target/surefire-reports/*.xml', allowEmptyResults: true

      emailext(
        to: "${EMAIL_TO}",
        subject: "[CI] ${currentBuild.currentResult} - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
        mimeType: 'text/html',
        body: """
          <p><b>Pipeline:</b> ${env.JOB_NAME}</p>
          <p><b>Build:</b> #${env.BUILD_NUMBER}</p>
          <p><b>Status:</b> ${currentBuild.currentResult}</p>
          <p><a href='${env.BUILD_URL}'>Open Build</a></p>
        """,
        attachmentsPattern: 'reports/**',
        attachLog: true
      )
    }
  }
}
