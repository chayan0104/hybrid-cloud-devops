pipeline {
  agent any

  environment {
    IMAGE_REGISTRY = 'mechayan97'
    MICROSERVICE_IMAGE_REPO = "${IMAGE_REGISTRY}/microservice"
    MAIN_APP_IMAGE_REPO = "${IMAGE_REGISTRY}/monolith"
    FRONTEND_IMAGE_REPO = "${IMAGE_REGISTRY}/frontend-angular"
    UAT_NAMESPACE = 'enterprise-uat'
    EMAIL_TO = 'chayansamanta8@gmail.com'
  }

  parameters {
    string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Image tag to deploy')
    string(name: 'DB_HOST', defaultValue: 'postgres-db', description: 'Database host')
    string(name: 'DB_PORT', defaultValue: '5432', description: 'Database port')
    string(name: 'DB_NAME', defaultValue: 'app_db', description: 'Database name')
    string(name: 'DB_USER', defaultValue: 'app_user', description: 'Database user')
    password(name: 'DB_PASSWORD', defaultValue: 'app_password', description: 'Database password')
    booleanParam(name: 'ROLLBACK_ONLY', defaultValue: false, description: 'Rollback Kubernetes deployments only')
  }

  stages {
    stage('Deploy UAT Images') {
      when {
        expression { return !params.ROLLBACK_ONLY }
      }
      steps {
        sh '''
          NEW_MICROSERVICE_IMAGE="${MICROSERVICE_IMAGE_REPO}:${IMAGE_TAG}"
          NEW_FRONTEND_IMAGE="${FRONTEND_IMAGE_REPO}:${IMAGE_TAG}"
          NEW_MAIN_APP_IMAGE="${MAIN_APP_IMAGE_REPO}:${IMAGE_TAG}"

          sed "s|__MICROSERVICE_IMAGE__|${NEW_MICROSERVICE_IMAGE}|g" infra/kubernetes/uat/microservice-deployment.yaml > infra/kubernetes/uat/microservice-deployment.rendered.yaml
          sed "s|__FRONTEND_IMAGE__|${NEW_FRONTEND_IMAGE}|g" infra/kubernetes/uat/frontend-deployment.yaml > infra/kubernetes/uat/frontend-deployment.rendered.yaml
          sed "s|__MAIN_APP_IMAGE__|${NEW_MAIN_APP_IMAGE}|g" infra/kubernetes/uat/monolith-deployment.yaml > infra/kubernetes/uat/monolith-deployment.rendered.yaml
          sed -e "s|__DB_HOST__|${DB_HOST}|g" -e "s|__DB_PORT__|${DB_PORT}|g" -e "s|__DB_NAME__|${DB_NAME}|g" -e "s|__DB_USER__|${DB_USER}|g" -e "s|__DB_PASSWORD__|${DB_PASSWORD}|g" infra/kubernetes/uat/microservice-secret.yaml > infra/kubernetes/uat/microservice-secret.rendered.yaml
          sed -e "s|__DB_HOST__|${DB_HOST}|g" -e "s|__DB_PORT__|${DB_PORT}|g" -e "s|__DB_NAME__|${DB_NAME}|g" -e "s|__DB_USER__|${DB_USER}|g" -e "s|__DB_PASSWORD__|${DB_PASSWORD}|g" infra/kubernetes/uat/monolith-secret.yaml > infra/kubernetes/uat/monolith-secret.rendered.yaml

          kubectl create namespace ${UAT_NAMESPACE} --dry-run=client -o yaml | kubectl apply -f -

          kubectl apply -f infra/kubernetes/uat/namespace.yaml
          kubectl apply -f infra/kubernetes/uat/microservice-configmap.yaml
          kubectl apply -f infra/kubernetes/uat/microservice-secret.rendered.yaml
          kubectl apply -f infra/kubernetes/uat/microservice-service.yaml
          kubectl apply -f infra/kubernetes/uat/frontend-service.yaml
          kubectl apply -f infra/kubernetes/uat/monolith-configmap.yaml
          kubectl apply -f infra/kubernetes/uat/monolith-secret.rendered.yaml
          kubectl apply -f infra/kubernetes/uat/monolith-service.yaml
          kubectl apply -f infra/kubernetes/uat/microservice-hpa.yaml
          kubectl apply -f infra/kubernetes/uat/microservice-deployment.rendered.yaml
          kubectl apply -f infra/kubernetes/uat/frontend-deployment.rendered.yaml
          kubectl apply -f infra/kubernetes/uat/monolith-deployment.rendered.yaml

          kubectl rollout status deployment/microservice -n ${UAT_NAMESPACE}
          kubectl rollout status deployment/frontend -n ${UAT_NAMESPACE}
          kubectl rollout status deployment/monolith -n ${UAT_NAMESPACE}
        '''
      }
    }

    stage('Validate UAT') {
      when {
        expression { return !params.ROLLBACK_ONLY }
      }
      steps {
        sh 'mkdir -p reports && kubectl get pods -n ${UAT_NAMESPACE} | tee reports/uat-pods.txt'
        sh '''
          kubectl port-forward -n ${UAT_NAMESPACE} svc/monolith 18080:80 > uat-monolith-port-forward.log 2>&1 &
          PF_PID=$!
          trap "kill ${PF_PID} >/dev/null 2>&1 || true" EXIT
          sleep 5
          curl -fsS http://127.0.0.1:18080/monolith/health >/dev/null
          curl -fsS http://127.0.0.1:18080/monolith/api/microservice-status | tee reports/uat-monolith-microservice-bridge.json
        '''
      }
    }

    stage('Rollback UAT') {
      when {
        expression { return params.ROLLBACK_ONLY }
      }
      steps {
        sh '''
          kubectl rollout undo deployment/microservice -n ${UAT_NAMESPACE} || true
          kubectl rollout undo deployment/frontend -n ${UAT_NAMESPACE} || true
          kubectl rollout undo deployment/monolith -n ${UAT_NAMESPACE} || true
        '''
      }
    }
  }

  post {
    always {
      sh 'rm -f infra/kubernetes/uat/*.rendered.yaml || true'
      script {
        sh """
          mkdir -p reports
          cat > reports/uat-summary.txt <<EOF
Build: ${env.BUILD_NUMBER}
Result: ${currentBuild.currentResult}
Image Tag: ${params.IMAGE_TAG}
Namespace: ${env.UAT_NAMESPACE}
DB Host: ${params.DB_HOST}
URL: ${env.BUILD_URL}
EOF
        """
      }
      archiveArtifacts artifacts: 'reports/**', allowEmptyArchive: true
      emailext(
        to: "${EMAIL_TO}",
        subject: "[UAT Deploy] ${currentBuild.currentResult} - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
        mimeType: 'text/html',
        body: """
          <p><b>Pipeline:</b> ${env.JOB_NAME}</p>
          <p><b>Status:</b> ${currentBuild.currentResult}</p>
          <p><b>Image Tag:</b> ${params.IMAGE_TAG}</p>
          <p><b>Namespace:</b> ${env.UAT_NAMESPACE}</p>
          <p><a href='${env.BUILD_URL}'>Open Build</a></p>
        """,
        attachmentsPattern: 'reports/**',
        attachLog: true
      )
    }
  }
}
