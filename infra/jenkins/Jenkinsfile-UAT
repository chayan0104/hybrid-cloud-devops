pipeline {
  agent any

  environment {
    IMAGE_REGISTRY = "${env.JFROG_SERVER}/${env.JFROG_DOCKER_REPO}"
    MICROSERVICE_IMAGE_REPO = "${IMAGE_REGISTRY}/microservice"
    MONOLITH_IMAGE_REPO = "${IMAGE_REGISTRY}/monolith"
    FRONTEND_IMAGE_REPO = "${IMAGE_REGISTRY}/frontend-angular"
    APP_NAMESPACE = 'enterprise-uat'
    EMAIL_TO = "${env.DEVOPS_NOTIFY_EMAIL}"
  }

  parameters {
    string(name: 'IMAGE_TAG', defaultValue: '', description: 'Immutable image tag to deploy')
    string(name: 'DB_HOST', defaultValue: '', description: 'MySQL host')
    string(name: 'DB_PORT', defaultValue: '3306', description: 'MySQL port')
    string(name: 'DB_NAME', defaultValue: 'app_db', description: 'Database name')
    booleanParam(name: 'ROLLBACK_ONLY', defaultValue: false, description: 'Rollback Kubernetes deployments only')
  }

  stages {
    stage('Deploy UAT Images') {
      when {
        expression { return !params.ROLLBACK_ONLY }
      }
      steps {
        withCredentials([
          usernamePassword(credentialsId: 'uat-mysql-credentials', usernameVariable: 'DB_USER', passwordVariable: 'DB_PASSWORD'),
          usernamePassword(credentialsId: 'jfrog-creds', usernameVariable: 'JFROG_USER', passwordVariable: 'JFROG_PASSWORD')
        ]) {
          sh '''
          set -eu
          : "${IMAGE_TAG:?IMAGE_TAG is required}"
          : "${DB_HOST:?DB_HOST is required}"
          : "${JFROG_SERVER:?Set the Jenkins JFROG_SERVER environment variable}"
          : "${JFROG_DOCKER_REPO:?Set the Jenkins JFROG_DOCKER_REPO environment variable}"
          K8S_DIR=infra/kubernetes/uat
          NEW_MICROSERVICE_IMAGE="${MICROSERVICE_IMAGE_REPO}:${IMAGE_TAG}"
          NEW_FRONTEND_IMAGE="${FRONTEND_IMAGE_REPO}:${IMAGE_TAG}"
          NEW_MONOLITH_IMAGE="${MONOLITH_IMAGE_REPO}:${IMAGE_TAG}"

          sed "s|__MICROSERVICE_IMAGE__|${NEW_MICROSERVICE_IMAGE}|g" "$K8S_DIR/microservice-deployment.yaml" > "$K8S_DIR/microservice-deployment.rendered.yaml"
          sed "s|__FRONTEND_IMAGE__|${NEW_FRONTEND_IMAGE}|g" "$K8S_DIR/frontend-deployment.yaml" > "$K8S_DIR/frontend-deployment.rendered.yaml"
          sed "s|__MAIN_APP_IMAGE__|${NEW_MONOLITH_IMAGE}|g" "$K8S_DIR/monolith-deployment.yaml" > "$K8S_DIR/monolith-deployment.rendered.yaml"
          sed -e "s|__DB_HOST__|${DB_HOST}|g" -e "s|__DB_PORT__|${DB_PORT}|g" -e "s|__DB_NAME__|${DB_NAME}|g" -e "s|__DB_USER__|${DB_USER}|g" -e "s|__DB_PASSWORD__|${DB_PASSWORD}|g" "$K8S_DIR/microservice-secret.yaml" > "$K8S_DIR/microservice-secret.rendered.yaml"
          sed -e "s|__DB_HOST__|${DB_HOST}|g" -e "s|__DB_PORT__|${DB_PORT}|g" -e "s|__DB_NAME__|${DB_NAME}|g" -e "s|__DB_USER__|${DB_USER}|g" -e "s|__DB_PASSWORD__|${DB_PASSWORD}|g" "$K8S_DIR/monolith-secret.yaml" > "$K8S_DIR/monolith-secret.rendered.yaml"

          kubectl apply -f "$K8S_DIR/namespace.yaml"
          umask 077
          DOCKER_CONFIG_FILE=$(mktemp)
          trap 'rm -f "$DOCKER_CONFIG_FILE"' EXIT
          DOCKER_AUTH=$(printf '%s' "${JFROG_USER}:${JFROG_PASSWORD}" | base64 | tr -d '\n')
          printf '{"auths":{"%s":{"auth":"%s"}}}' "$JFROG_SERVER" "$DOCKER_AUTH" > "$DOCKER_CONFIG_FILE"
          kubectl create secret generic jfrog-registry --type=kubernetes.io/dockerconfigjson --from-file=.dockerconfigjson="$DOCKER_CONFIG_FILE" -n "$APP_NAMESPACE" --dry-run=client -o yaml | kubectl apply -f -
          kubectl apply -f "$K8S_DIR/microservice-configmap.yaml"
          kubectl apply -f "$K8S_DIR/monolith-configmap.yaml"
          kubectl apply -f "$K8S_DIR/microservice-secret.rendered.yaml"
          kubectl apply -f "$K8S_DIR/monolith-secret.rendered.yaml"
          kubectl apply -f "$K8S_DIR/frontend-service.yaml"
          kubectl apply -f "$K8S_DIR/frontend-deployment.rendered.yaml"
          kubectl apply -f "$K8S_DIR/monolith-service.yaml"
          kubectl apply -f "$K8S_DIR/monolith-deployment.rendered.yaml"
          kubectl apply -f "$K8S_DIR/microservice-service.yaml"
          kubectl apply -f "$K8S_DIR/microservice-deployment.rendered.yaml"
          kubectl apply -f "$K8S_DIR/microservice-hpa.yaml"

          kubectl rollout status deployment/microservice -n ${APP_NAMESPACE}
          kubectl rollout status deployment/frontend -n ${APP_NAMESPACE}
          kubectl rollout status deployment/monolith -n ${APP_NAMESPACE}
          '''
        }
      }
    }

    stage('Validate UAT') {
      when {
        expression { return !params.ROLLBACK_ONLY }
      }
      steps {
        sh 'mkdir -p reports && kubectl get pods -n ${APP_NAMESPACE} | tee reports/uat-pods.txt'
        sh '''
          kubectl port-forward -n ${APP_NAMESPACE} svc/monolith 18080:80 > uat-monolith-port-forward.log 2>&1 &
          PF_PID=$!
          trap "kill ${PF_PID} >/dev/null 2>&1 || true" EXIT
          sleep 5
          curl -fsS http://127.0.0.1:18080/monolith/health >/dev/null
          curl -fsS http://127.0.0.1:18080/monolith/api/microservice-status | tee reports/uat-monolith-microservice-bridge.json
        '''
      }
    }

    stage('Rollback UAT') {
      when {
        expression { return params.ROLLBACK_ONLY }
      }
      steps {
        sh '''
          kubectl rollout undo deployment/microservice -n ${APP_NAMESPACE} || true
          kubectl rollout undo deployment/frontend -n ${APP_NAMESPACE} || true
          kubectl rollout undo deployment/monolith -n ${APP_NAMESPACE} || true
        '''
      }
    }
  }

  post {
    always {
      sh 'rm -f infra/kubernetes/uat/*.rendered.yaml || true'
      script {
        sh """
          mkdir -p reports
          cat > reports/uat-summary.txt <<EOF
Build: ${env.BUILD_NUMBER}
Result: ${currentBuild.currentResult}
Image Tag: ${params.IMAGE_TAG}
Namespace: ${env.APP_NAMESPACE}
DB Host: ${params.DB_HOST}
URL: ${env.BUILD_URL}
EOF
        """
      }
      archiveArtifacts artifacts: 'reports/**', allowEmptyArchive: true
      emailext(
        to: "${EMAIL_TO}",
        subject: "[UAT Deploy] ${currentBuild.currentResult} - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
        mimeType: 'text/html',
        body: """
          <p><b>Pipeline:</b> ${env.JOB_NAME}</p>
          <p><b>Status:</b> ${currentBuild.currentResult}</p>
          <p><b>Image Tag:</b> ${params.IMAGE_TAG}</p>
          <p><b>Namespace:</b> ${env.APP_NAMESPACE}</p>
          <p><a href='${env.BUILD_URL}'>Open Build</a></p>
        """,
        attachmentsPattern: 'reports/**',
        attachLog: true
      )
    }
  }
}
